# Optional: override the Vite development proxy backend target.
# Used by `npm run dev`; do not include a trailing slash.
VITE_BACKEND_URL=http://localhost:7777

# Optional: explicitly set the REST API base URL. Defaults to /api (recommended).
# For same-origin deployments, leave unset or use /api.
# VITE_API_BASE_URL=/api

# Optional: explicitly set the Socket.IO server URL. Defaults to the current page origin.
# For same-origin deployments, leave unset.
# VITE_SOCKET_URL=http://localhost:7777
